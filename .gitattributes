* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
gradlew text eol=lf

*.jar binary
*.png binary
*.jpg binary
*.jpeg binary

# Private research artifacts. Git stores small pointer files; GitHub LFS stores
# the untouched APKs and annotated IDA databases.
research/artifacts/**/*.apk filter=lfs diff=lfs merge=lfs -text
research/artifacts/**/*.i64 filter=lfs diff=lfs merge=lfs -text
